// Generated by slai for agent {{json .Agent}}. Rewritten on every agent start: do not edit.
//
// What this extension does for the pi harness:
//   - registers the slai MCP server with the agent identity pinned (env AND args);
//   - reports pi's lifecycle to `slai hook` using slai's neutral payload;
//   - guards every tool call through `slai hook tool` and FAILS CLOSED: if the hook
//     cannot be run, errors, times out or answers anything but allow, the tool call
//     is blocked (pi has no permission layer, so this is the only write control);
//   - writes {{json .RunDir}}/guard_ready once the guard is proven reachable.
import { spawn, spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const AGENT = {{json .Agent}};
const PROJECT = {{json .Project}};
const SLAI = {{json .Slai}};
const RUN_DIR = {{json .RunDir}};
const GUARD_TIMEOUT_MS = {{.GuardTimeoutMS}};

// Identity is baked in. Nothing below reads SLAI_AGENT_ID or SLAI_PROJECT from the
// ambient environment.
const PINNED_ENV = { SLAI_AGENT_ID: AGENT, SLAI_PROJECT: PROJECT };
const hookArgs = (event) => ["hook", event, "--agent", AGENT, "--project", PROJECT];
const childEnv = () => ({ ...process.env, ...PINNED_ENV });

// pi tool names -> the names slai's lane guard knows.
const CLAUDE_NAMES = { bash: "Bash", write: "Write", edit: "Edit", read: "Read", grep: "Grep", find: "Glob", ls: "LS" };
const claudeName = (tool) => CLAUDE_NAMES[tool] || tool;
function claudeInput(tool, input) {
  const i = input && typeof input === "object" ? input : {};
  if (tool === "write" || tool === "edit") return { ...i, file_path: i.path };
  return i;
}

let sessionId = "";
let usage = { prompt: 0, output: 0, cost: 0 };

/** Fire and forget: status reports must never slow or break pi. */
export function report(event, payload) {
  try {
    const child = spawn(SLAI, hookArgs(event), { env: childEnv(), stdio: ["pipe", "ignore", "ignore"] });
    child.on("error", () => {});
    child.stdin.on("error", () => {});
    child.stdin.end(JSON.stringify({ event, session_id: sessionId, ...payload }));
  } catch (_) {
    /* reporting is best effort */
  }
}

/**
 * Run `slai hook <event>` and wait. Returns {allow, reason}. For a tool call (the
 * default, explicit = true) allow is true ONLY when the hook ran, exited 0 and
 * printed {"decision":"allow"}: silence is not consent, because a hook that failed
 * quietly looks the same. Every other outcome is a block, with a reason that says
 * why. explicit = false is for probes and reports, which print nothing on success:
 * there, exit 0 is all that is asked.
 */
export function ask(event, payload, explicit = true) {
  let r;
  try {
    r = spawnSync(SLAI, hookArgs(event), {
      env: childEnv(),
      input: JSON.stringify({ event, session_id: sessionId, ...payload }),
      encoding: "utf8",
      timeout: GUARD_TIMEOUT_MS,
      maxBuffer: 1 << 20,
    });
  } catch (e) {
    return { allow: false, reason: "slai lane guard unavailable (could not run slai hook: " + e + "); blocked" };
  }
  if (r.error) return { allow: false, reason: "slai lane guard unavailable (" + r.error.code + "): " + r.error.message + "; blocked" };
  if (r.signal) return { allow: false, reason: "slai lane guard unavailable (hook killed by " + r.signal + "); blocked" };
  if (r.status !== 0) return { allow: false, reason: "slai lane guard unavailable (hook exited " + r.status + "); blocked" };
  const out = (r.stdout || "").trim();
  if (out === "") {
    return explicit
      ? { allow: false, reason: "slai lane guard gave no explicit allow (empty answer); blocked" }
      : { allow: true, reason: "" };
  }
  let d;
  try {
    d = JSON.parse(out);
  } catch (_) {
    return { allow: false, reason: "slai lane guard unavailable (unreadable answer); blocked" };
  }
  if (d && d.decision === "allow") return { allow: true, reason: "" };
  if (d && d.decision === "deny") return { allow: false, reason: d.reason || "slai lane guard: denied" };
  return { allow: false, reason: "slai lane guard unavailable (unexpected answer); blocked" };
}

function markGuardReady() {
  try {
    fs.mkdirSync(RUN_DIR, { recursive: true });
    fs.writeFileSync(path.join(RUN_DIR, "guard_ready"), JSON.stringify({ agent: AGENT, at: Math.floor(Date.now() / 1000), pid: process.pid }) + "\n");
  } catch (_) {
    /* without the file the supervisor holds the agent: the safe direction */
  }
}

export default function (pi) {
  // A stale marker from a previous run must not vouch for this one.
  try {
    fs.rmSync(path.join(RUN_DIR, "guard_ready"), { force: true });
  } catch (_) {}

  pi.registerMcpServer("slai", {
    command: SLAI,
    args: ["mcp", "--agent", AGENT, "--project", PROJECT],
    env: PINNED_ENV,
    // direct: the slai tools are declared to the model like built-ins. The default
    // (codemode) leaves them unreachable when no codemode/tool_search tool is active.
    exposure: "direct",
  });

  pi.on("session_start", async (_e, ctx) => {
    try {
      sessionId = (ctx && ctx.sessionManager && ctx.sessionManager.getSessionId && ctx.sessionManager.getSessionId()) || "";
    } catch (_) {}
    // The session_start report doubles as the guard probe: if slai hook answers, the
    // guard (which uses the same call) will too.
    const probe = ask("session_start", {}, false);
    if (probe.allow) {
      markGuardReady();
      report("guard_ready", {}); // the same fact as the marker file, as an event
    }
  });

  pi.on("before_agent_start", async () => report("prompt", {}));

  // The guard. Any failure inside it is a block; so is throwing (pi blocks on a
  // failing tool_call handler).
  pi.on("tool_call", async (e, ctx) => {
    try {
      const verdict = ask("tool", {
        tool: claudeName(e.toolName),
        tool_input: claudeInput(e.toolName, e.input),
        cwd: (ctx && ctx.cwd) || process.cwd(),
      });
      if (!verdict.allow) return { block: true, reason: verdict.reason };
    } catch (err) {
      return { block: true, reason: "slai lane guard failed (" + err + "); blocked" };
    }
    return undefined;
  });

  pi.on("tool_result", async () => report("tool_end", {}));

  pi.on("message_end", async (e) => {
    const m = e && e.message;
    if (!m || m.role !== "assistant" || !m.usage) return;
    const u = m.usage;
    usage.prompt += (u.input || 0) + (u.cacheRead || 0) + (u.cacheWrite || 0);
    usage.output += u.output || 0;
    usage.cost += (u.cost && u.cost.total) || 0;
  });

  // agent_settled: pi will not continue on its own. Spend is reported as a delta
  // with the stop event.
  pi.on("agent_settled", async () => {
    const delta = usage;
    usage = { prompt: 0, output: 0, cost: 0 };
    report("stop", { usage: delta });
  });
}
