// Generated by slai for agent {{.AgentName}}. Do not edit: it is rewritten on every start.
//
// Pushes OpenCode's events into `slai hook` (status, session id, usage) and enforces
// the lane guard on every tool call. Identity is baked in below; nothing is read from
// the environment, which belongs to whoever started opencode.
import { spawnSync } from "node:child_process"

const SLAI = {{.Bin}}
const AGENT = {{.Agent}}
const PROJECT = {{.Project}}
const HOOK_TIMEOUT_MS = 8000

// hook runs `slai hook <event> --agent .. --project ..` with the payload on stdin.
// ok is false when slai could not be run or did not exit 0 (the guard fails closed).
function hook(event, payload) {
  const r = spawnSync(SLAI, ["hook", event, "--agent", AGENT, "--project", PROJECT], {
    input: JSON.stringify({ event, ...payload }),
    encoding: "utf8",
    timeout: HOOK_TIMEOUT_MS,
  })
  const ok = !r.error && r.status === 0 && !r.signal
  let decision = null
  if (ok && r.stdout && r.stdout.trim()) {
    try { decision = JSON.parse(r.stdout.trim()) } catch (_) { decision = { decision: "deny", reason: "unreadable guard reply" } }
  }
  return { ok, decision }
}

export const SlaiPlugin = async () => {
  let ready = false
  let busy = false
  const seen = new Map() // message id -> tokens/cost already reported
  let pending = { prompt: 0, output: 0, cost: 0 } // usage not yet sent (rides on the next stop)

  // The guard counts as registered once the plugin has seen a real session event
  // (the factory also runs for non-interactive commands such as `opencode debug config`).
  const ensureReady = () => {
    if (!ready) { ready = true; hook("guard_ready", {}) }
  }
  const stop = () => {
    if (!busy) return
    busy = false
    const usage = pending.prompt || pending.output || pending.cost ? { ...pending } : undefined
    pending = { prompt: 0, output: 0, cost: 0 }
    hook("stop", usage ? { usage } : {})
  }
  const noteUsage = (info) => {
    if (!info || info.role !== "assistant" || !info.tokens) return
    const t = info.tokens
    const now = {
      prompt: (t.input || 0) + ((t.cache && (t.cache.read || 0) + (t.cache.write || 0)) || 0),
      output: (t.output || 0) + (t.reasoning || 0),
      cost: info.cost || 0,
    }
    const before = seen.get(info.id) || { prompt: 0, output: 0, cost: 0 }
    seen.set(info.id, now)
    pending.prompt += Math.max(now.prompt - before.prompt, 0)
    pending.output += Math.max(now.output - before.output, 0)
    pending.cost += Math.max(now.cost - before.cost, 0)
  }

  return {
    event: async ({ event }) => {
      const type = event && event.type
      const props = (event && event.properties) || {}
      ensureReady()
      switch (type) {
        case "session.created": {
          const info = props.info || {}
          hook("session_start", { session_id: props.sessionID || info.id || "", cwd: info.directory || "" })
          break
        }
        case "session.status": {
          const st = props.status && props.status.type
          if (st === "busy") busy = true
          if (st === "idle") stop()
          break
        }
        case "session.idle":
          stop()
          break
        case "permission.asked":
          hook("waiting", {})
          break
        case "message.updated":
          noteUsage(props.info)
          break
      }
    },
    "chat.message": async () => {
      ensureReady()
      busy = true
      hook("prompt", {})
    },
    "tool.execute.before": async (input, output) => {
      ensureReady()
      busy = true
      const r = hook("tool", { tool: input.tool, tool_input: output && output.args, session_id: input.sessionID })
      if (!r.ok) throw new Error("slai lane guard unavailable; refusing the tool call")
      // only an explicit allow lets the call through: silence, garbage or a deny all block
      if (!r.decision || r.decision.decision !== "allow") throw new Error((r.decision && r.decision.reason) || "slai lane guard: no explicit allow")
    },
    "tool.execute.after": async (input) => {
      hook("tool_end", { tool: input.tool, session_id: input.sessionID })
    },
  }
}
