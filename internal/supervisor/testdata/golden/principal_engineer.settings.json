{
  "env": {
    "SLAI_AGENT_ID": "principal",
    "SLAI_PROJECT": "<PROJ>"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "slai hook notification --agent principal",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "slai hook pretooluse --agent principal",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "slai hook sessionstart --agent principal",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "slai hook stop --agent principal",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "slai hook userpromptsubmit --agent principal",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__slai__get_board",
      "mcp__slai__review_diff",
      "mcp__slai__approve",
      "mcp__slai__request_changes",
      "mcp__slai__send_message",
      "mcp__slai__ask",
      "mcp__slai__get_inbox",
      "mcp__slai__pong",
      "mcp__slai__reply",
      "mcp__slai__remember",
      "mcp__slai__recall",
      "mcp__slai__get_memory",
      "Edit(.slai/decisions.md)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "EnterWorktree",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)"
    ]
  },
  "statusLine": {
    "command": "slai statusline --agent principal",
    "type": "command"
  }
}
