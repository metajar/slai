{
  "env": {
    "SLAI_AGENT_ID": "eng-1",
    "SLAI_PROJECT": "<PROJ>"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "slai hook notification --agent eng-1",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "slai hook posttooluse --agent eng-1",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "slai hook pretooluse --agent eng-1",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "slai hook sessionstart --agent eng-1",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "slai hook stop --agent eng-1",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "slai hook userpromptsubmit --agent eng-1",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__slai__get_task",
      "mcp__slai__report",
      "mcp__slai__request_review",
      "mcp__slai__ask",
      "mcp__slai__send_message",
      "mcp__slai__get_inbox",
      "mcp__slai__pong",
      "mcp__slai__reply",
      "mcp__slai__remember",
      "mcp__slai__recall",
      "mcp__slai__get_memory",
      "mcp__slai__whoami",
      "Edit(/<PROJ>/.slai/worktrees/eng-1/**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "EnterWorktree"
    ]
  },
  "statusLine": {
    "command": "slai statusline --agent eng-1",
    "type": "command"
  }
}
